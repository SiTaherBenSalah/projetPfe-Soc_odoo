<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  SOC Management Menu Structure                                 -->
    <!--  Only the Dashboard is shown in the menu.                      -->
    <!--  All other views are accessible via Dashboard quick-links.     -->
    <!-- ══════════════════════════════════════════════════════════════ -->

    <!-- Root Menu -->
    <menuitem id="menu_soc_root"
              name="SOC Management"
              web_icon="soc_management,static/description/icon.png"
              sequence="5"/>

    <!-- Dashboard (unique menu item) -->
    <menuitem id="menu_soc_dashboard"
              name="Dashboard"
              parent="menu_soc_root"
              action="action_soc_dashboard"
              sequence="1"/>

</odoo>
