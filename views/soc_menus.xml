<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  SOC Management Menu Structure                                 -->
    <!-- ══════════════════════════════════════════════════════════════ -->

    <!-- Root Menu -->
    <menuitem id="menu_soc_root"
              name="SOC Management"
              web_icon="soc_management,static/description/icon.png"
              sequence="5"/>

    <!-- Dashboard -->
    <menuitem id="menu_soc_dashboard"
              name="Dashboard"
              parent="menu_soc_root"
              action="action_soc_dashboard"
              sequence="1"/>

    <!-- Alerts -->
    <menuitem id="menu_soc_alerts_parent"
              name="Alerts"
              parent="menu_soc_root"
              sequence="10"/>

    <menuitem id="menu_soc_alerts_all"
              name="All Alerts"
              parent="menu_soc_alerts_parent"
              action="action_soc_alert"
              sequence="1"/>

    <menuitem id="menu_soc_alerts_tunisia"
              name="Tunisia Alerts"
              parent="menu_soc_alerts_parent"
              action="action_soc_alert_tunisia"
              sequence="2"/>

    <menuitem id="menu_soc_alerts_critical"
              name="Critical Alerts"
              parent="menu_soc_alerts_parent"
              action="action_soc_alert_critical"
              sequence="3"/>

    <!-- Incidents -->
    <menuitem id="menu_soc_incidents"
              name="Incidents"
              parent="menu_soc_root"
              action="action_soc_incident"
              sequence="20"/>

    <!-- Threat Intelligence -->
    <menuitem id="menu_soc_threat_intel_parent"
              name="Threat Intelligence"
              parent="menu_soc_root"
              sequence="30"/>

    <menuitem id="menu_soc_threat_intel"
              name="Intelligence Data"
              parent="menu_soc_threat_intel_parent"
              action="action_soc_threat_intel"
              sequence="1"/>

    <menuitem id="menu_soc_mitre_tactics"
              name="MITRE ATT&amp;CK Tactics"
              parent="menu_soc_threat_intel_parent"
              action="action_soc_mitre_tactic"
              sequence="2"/>

    <menuitem id="menu_soc_mitre_techniques"
              name="MITRE ATT&amp;CK Techniques"
              parent="menu_soc_threat_intel_parent"
              action="action_soc_mitre_technique"
              sequence="3"/>

    <!-- ─── DevSecOps Pipeline ──────────────────────────────── -->
    <menuitem id="menu_soc_devsecops_parent"
              name="DevSecOps"
              parent="menu_soc_root"
              sequence="40"/>

    <menuitem id="menu_devsecops_scans"
              name="Security Scans"
              parent="menu_soc_devsecops_parent"
              action="action_devsecops_scan"
              sequence="1"/>

    <menuitem id="menu_devsecops_findings"
              name="Findings"
              parent="menu_soc_devsecops_parent"
              action="action_devsecops_finding"
              sequence="2"/>

    <menuitem id="menu_devsecops_profiles"
              name="Scan Profiles"
              parent="menu_soc_devsecops_parent"
              action="action_devsecops_profile"
              sequence="3"/>

    <!-- Configuration -->
    <menuitem id="menu_soc_config_parent"
              name="Configuration"
              parent="menu_soc_root"
              sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_soc_wazuh_config"
              name="Wazuh Connector"
              parent="menu_soc_config_parent"
              action="action_soc_wazuh_config"
              sequence="1"/>

    <menuitem id="menu_soc_ai_config"
              name="AI Agent"
              parent="menu_soc_config_parent"
              action="action_soc_ai_agent"
              sequence="2"/>

    <menuitem id="menu_soc_tunisia_ip"
              name="Tunisia IP Ranges"
              parent="menu_soc_config_parent"
              action="action_soc_tunisia_ip"
              sequence="3"/>

    <menuitem id="menu_devsecops_jenkins"
              name="Jenkins &amp; CI/CD"
              parent="menu_soc_config_parent"
              action="action_devsecops_jenkins"
              sequence="10"/>

</odoo>
