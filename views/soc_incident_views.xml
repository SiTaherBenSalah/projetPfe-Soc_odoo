<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  SOC Incident Views                                            -->
    <!-- ══════════════════════════════════════════════════════════════ -->

    <!-- Incident Tree View -->
    <record id="view_soc_incident_tree" model="ir.ui.view">
        <field name="name">soc.incident.tree</field>
        <field name="model">soc.incident</field>
        <field name="arch" type="xml">
            <tree string="Security Incidents"
                  decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'high'"
                  decoration-info="severity == 'medium'"
                  default_order="create_date desc">
                <field name="name"/>
                <field name="title"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'critical'"
                       decoration-warning="severity == 'high'"
                       decoration-info="severity == 'medium'"
                       decoration-success="severity == 'low'"/>
                <field name="category"/>
                <field name="impact" widget="badge"/>
                <field name="source_ip"/>
                <field name="alert_count"/>
                <field name="analyst_id" widget="many2one_avatar_user"/>
                <field name="detection_date"/>
                <field name="time_to_contain" widget="float_time"
                       optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state in ('triage', 'investigation')"
                       decoration-danger="state in ('containment', 'eradication')"
                       decoration-success="state in ('recovery', 'closed')"
                       decoration-muted="state == 'post_incident'"/>
            </tree>
        </field>
    </record>

    <!-- Incident Form View -->
    <record id="view_soc_incident_form" model="ir.ui.view">
        <field name="name">soc.incident.form</field>
        <field name="model">soc.incident</field>
        <field name="arch" type="xml">
            <form string="Security Incident">
                <header>
                    <button name="action_start_triage" string="Start Triage"
                            type="object" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_start_investigation" string="Investigate"
                            type="object" class="btn-primary"
                            invisible="state != 'triage'"/>
                    <button name="action_start_containment" string="Contain"
                            type="object" class="btn-warning"
                            invisible="state != 'investigation'"/>
                    <button name="action_start_eradication" string="Eradicate"
                            type="object" class="btn-warning"
                            invisible="state != 'containment'"/>
                    <button name="action_start_recovery" string="Recover"
                            type="object" class="btn-success"
                            invisible="state != 'eradication'"/>
                    <button name="action_post_incident" string="Post-Incident Review"
                            type="object"
                            invisible="state != 'recovery'"/>
                    <button name="action_close" string="Close Incident"
                            type="object"
                            invisible="state not in ('post_incident', 'recovery')"/>
                    <button name="action_reopen" string="Reopen"
                            type="object"
                            invisible="state != 'closed'"/>
                    <button name="action_ai_analyze" string="🤖 AI Analysis"
                            type="object" class="btn-secondary"
                            invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,triage,investigation,containment,eradication,recovery,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_alerts" type="object"
                                class="oe_stat_button" icon="fa-bell">
                            <field name="alert_count" widget="statinfo"
                                   string="Alerts"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="title" placeholder="Incident Title..."/>
                        </h2>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="severity"/>
                            <field name="category"/>
                            <field name="impact"/>
                        </group>
                        <group string="Assignment">
                            <field name="analyst_id" widget="many2one_avatar_user"/>
                            <field name="team_member_ids" widget="many2many_tags_avatar"/>
                            <field name="detection_date"/>
                        </group>
                    </group>

                    <group>
                        <group string="Network">
                            <field name="source_ip"/>
                            <field name="destination_ip"/>
                        </group>
                        <group string="Time Metrics">
                            <field name="time_to_detect" widget="float_time"/>
                            <field name="time_to_contain" widget="float_time"/>
                            <field name="time_to_resolve" widget="float_time"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Incident description..."/>
                            <separator string="Affected Systems"/>
                            <field name="affected_systems"
                                   placeholder="List affected systems, servers, services..."/>
                        </page>

                        <page string="Response Plan" name="response">
                            <group string="Response Plan">
                                <field name="response_plan" nolabel="1" colspan="2"
                                       placeholder="Outline the incident response plan..."/>
                            </group>
                            <group string="Containment Actions">
                                <field name="containment_actions" nolabel="1" colspan="2"
                                       placeholder="Actions taken to contain the incident..."/>
                                <field name="containment_date"/>
                            </group>
                            <group string="Eradication Actions">
                                <field name="eradication_actions" nolabel="1" colspan="2"
                                       placeholder="Actions taken to eradicate the threat..."/>
                                <field name="eradication_date"/>
                            </group>
                            <group string="Recovery Actions">
                                <field name="recovery_actions" nolabel="1" colspan="2"
                                       placeholder="Recovery and restoration actions..."/>
                                <field name="recovery_date"/>
                            </group>
                        </page>

                        <page string="AI Analysis" name="ai_analysis">
                            <group string="AI Threat Analysis">
                                <field name="ai_analysis" nolabel="1" colspan="2"/>
                            </group>
                            <group string="AI Response Suggestion">
                                <field name="ai_response_suggestion" nolabel="1" colspan="2"/>
                            </group>
                        </page>

                        <page string="MITRE ATT&amp;CK" name="mitre">
                            <group>
                                <field name="mitre_tactic_id"/>
                                <field name="mitre_technique_ids" widget="many2many_tags"/>
                            </group>
                        </page>

                        <page string="Related Alerts" name="alerts">
                            <field name="alert_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="severity" widget="badge"/>
                                    <field name="source_ip"/>
                                    <field name="category"/>
                                    <field name="timestamp"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Post-Incident" name="post_incident">
                            <group string="Executive Summary">
                                <field name="summary" nolabel="1" colspan="2"
                                       placeholder="Executive summary for management..."/>
                            </group>
                            <group string="Lessons Learned">
                                <field name="lessons_learned" nolabel="1" colspan="2"
                                       placeholder="What was learned from this incident..."/>
                            </group>
                            <group string="Recommendations">
                                <field name="recommendations" nolabel="1" colspan="2"
                                       placeholder="Recommendations to prevent recurrence..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Incident Search View -->
    <record id="view_soc_incident_search" model="ir.ui.view">
        <field name="name">soc.incident.search</field>
        <field name="model">soc.incident</field>
        <field name="arch" type="xml">
            <search string="Search Incidents">
                <field name="name"/>
                <field name="title"/>
                <field name="source_ip"/>
                <field name="analyst_id"/>
                <separator/>
                <filter string="Open Incidents" name="filter_open"
                        domain="[('state', 'not in', ['closed', 'post_incident'])]"/>
                <filter string="Critical" name="filter_critical"
                        domain="[('severity', '=', 'critical')]"/>
                <filter string="High Priority" name="filter_high"
                        domain="[('severity', 'in', ['high', 'critical'])]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Severity" name="group_severity"
                            context="{'group_by': 'severity'}"/>
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Analyst" name="group_analyst"
                            context="{'group_by': 'analyst_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Incident Kanban -->
    <record id="view_soc_incident_kanban" model="ir.ui.view">
        <field name="name">soc.incident.kanban</field>
        <field name="model">soc.incident</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="title"/>
                <field name="severity"/>
                <field name="category"/>
                <field name="state"/>
                <field name="alert_count"/>
                <field name="analyst_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click
                            #{record.severity.raw_value == 'critical' ? 'border-danger border-start border-4' :
                              record.severity.raw_value == 'high' ? 'border-warning border-start border-4' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <strong><field name="name"/></strong>
                                    <field name="severity" widget="badge"
                                           decoration-danger="severity == 'critical'"
                                           decoration-warning="severity == 'high'"/>
                                </div>
                                <div><field name="title"/></div>
                                <div class="text-muted small mt-1">
                                    <span class="badge text-bg-secondary" t-if="record.category.raw_value">
                                        <field name="category"/>
                                    </span>
                                    <span class="ms-1">
                                        <i class="fa fa-bell"/> <field name="alert_count"/> alerts
                                    </span>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_right">
                                        <field name="analyst_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Incident Actions -->
    <record id="action_soc_incident" model="ir.actions.act_window">
        <field name="name">Security Incidents</field>
        <field name="res_model">soc.incident</field>
        <field name="view_mode">tree,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="view_soc_incident_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No security incidents
            </p>
            <p>
                Incidents are created when alerts are escalated.
                Start by reviewing security alerts from the Alerts menu.
            </p>
        </field>
    </record>

</odoo>
