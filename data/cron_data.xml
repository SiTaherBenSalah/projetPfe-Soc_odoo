<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  Cron Jobs                                                 -->
        <!-- ══════════════════════════════════════════════════════════ -->

        <!-- Fetch Wazuh alerts every 5 minutes -->
        <record id="cron_fetch_wazuh_alerts" model="ir.cron">
            <field name="name">SOC: Fetch Wazuh Alerts</field>
            <field name="model_id" ref="model_soc_wazuh_connector"/>
            <field name="state">code</field>
            <field name="code">model.fetch_alerts_cron()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall">False</field>
        </record>

        <!-- Auto-close false positives daily -->
        <record id="cron_auto_close_fp" model="ir.cron">
            <field name="name">SOC: Auto-Close False Positives</field>
            <field name="model_id" ref="model_soc_alert"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_close_false_positives()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall">False</field>
        </record>

    </data>
</odoo>
